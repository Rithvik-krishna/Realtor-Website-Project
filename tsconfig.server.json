{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "Frontend/**/*", 
    "src/pages/**/*", 
    "src/components/**/*", 
    "src/context/**/*", 
    "src/design-system/**/*",
    "src/services/api.ts",
    "src/main.tsx",
    "src/App.tsx",
    "src/App.css",
    "src/index.css"
  ]
}
