{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "express"]
  },
  "include": [
    "src/server.ts",
    "src/app.ts",
    "src/config/**/*",
    "src/api/**/*",
    "src/controllers/**/*",
    "src/database/**/*",
    "src/middleware/**/*",
    "src/modules/**/*",
    "src/routes/**/*",
    "src/services/trrebService.ts",
    "src/utils/**/*"
  ],
  "exclude": [
    "src/App.tsx",
    "src/main.tsx",
    "src/components/**/*",
    "src/context/**/*",
    "src/pages/**/*",
    "src/services/api.ts",
    "src/design-system/**/*"
  ]
}
