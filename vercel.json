{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://realtor-website-project.onrender.com/api/$1"
    },
    {
      "source": "/((?!api|sitemap|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
